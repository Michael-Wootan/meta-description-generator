# Copy to .env (never commit .env).

# --- Secrets ---
SHOPIFY_STORE=your-store.myshopify.com
# Admin API token with read/write on products, collections, content and metafields
SHOPIFY_ADMIN_TOKEN=

# --- Configuration (optional) ---
# Overrides "brand" in config/meta.json
# COMPANY_NAME=Acme Supply Co.
# CONFIG_DIR=./config
# STATE_DIR=./state
